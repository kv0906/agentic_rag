#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."
SECONDS=0

# Amp's base image provides Node, Python and uv; fail clearly if it changes.
node -e 'if (Number(process.versions.node.split(".")[0]) < 20) throw new Error("Node.js 20+ is required")'
python3 -c 'import sys; assert sys.version_info >= (3, 11), "Python 3.11+ is required"'
uv --version

echo "[setup ${SECONDS}s] Installing frontend dependencies from package-lock.json"
npm ci --prefer-offline --no-audit --no-fund

echo "[setup ${SECONDS}s] Installing backend dependencies (CPU-only PyTorch)"
if [[ ! -x .venv/bin/python ]]; then
  uv venv --python python3 .venv
fi
# NLTK rejects hardlinked corpus files, so copy wheels out of uv's cache.
uv pip install --python .venv/bin/python --link-mode copy --torch-backend cpu -r backend/requirements.txt

# Never write credentials into a shared snapshot. The API can boot without a key;
# supply OPENAI_API_KEY through Amp secrets when exercising chat or embeddings.
echo "[setup ${SECONDS}s] Ready: npm run dev / npm run backend"
